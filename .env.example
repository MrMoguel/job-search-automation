# --- Base de datos ---
DB_HOST=db
DB_PORT=5432
DB_NAME=jobsearch
DB_USER=jobsearch
DB_PASSWORD_FILE=/run/secrets/db_password

# --- Auth interna entre Hermes y workers ---
INTERNAL_TOKEN=changeme_generate_a_random_string

# --- LLM para scoring/clasificación ---
# Por defecto: proxy OpenAI-compatible de Hermes (Grok vía SuperGrok OAuth, sin API key paga).
LLM_BASE_URL=http://hermes-proxy:8645/v1
LLM_MODEL=grok-4.3
LLM_API_KEY=hermes-proxy
# Opcional: solo si volvés a Anthropic vía otro gateway.
ANTHROPIC_API_KEY=

# --- Umbral de score para pasar a cola de aplicación ---
SCORE_THRESHOLD=70

# --- Perfil del candidato (scoring + formularios deterministas) ---
# Texto libre para scoring (legacy; también se usa como summary si no hay APPLICANT_SUMMARY).
CANDIDATE_PROFILE_TEXT="Pegar acá un resumen del perfil/CV de Miguel"

# Contrato estructurado consumido por adaptadores Playwright (sin LLM por postulación).
APPLICANT_FULL_NAME=
APPLICANT_FIRST_NAME=
APPLICANT_LAST_NAME=
APPLICANT_EMAIL=
APPLICANT_PHONE=
APPLICANT_COUNTRY=CL
APPLICANT_CITY=
APPLICANT_LINKEDIN_URL=
# Path al CV dentro del contenedor workers, ej. /app/secrets/cv.pdf
APPLICANT_RESUME_PATH=
APPLICANT_COVER_LETTER=
APPLICANT_SUMMARY=
# JSON opcional de respuestas frecuentes, ej. {"years_experience":"5","work_authorization":"yes"}
APPLICANT_CUSTOM_ANSWERS_JSON=
# Opcional: path a un JSON que sobrescribe campos (útil en Docker volume).
APPLICANT_PROFILE_JSON=

# --- Gmail API (OAuth2, para tracking) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
GMAIL_REFRESH_TOKEN=

# --- Telegram (canal usuario <-> Hermes) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
